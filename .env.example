# Default values
# If left unset it fallback to defaults

SHELFD_PORT=8080
SHELFD_ENV=production # or development
SHELFD_LOG_FORMAT=pretty # or json, or kv-pair
SHELFD_SESSION_LENGTH=43200 # minutes (30 days)

# Argon configuration used for password hashing
# These are the absolute minimum recommended values
# should be safe to run a Raspberry Pi, while still being secure
SHELFD_ARGON_TIME=3
SHELFD_ARGON_MEMORY=19456 # MB of memory used for every password hash
SHELFD_ARGON_THREADS=2 # adjust to your cpu
SHELFD_ARGON_SALT_SIZE=16 # bytes
SHELFD_ARGON_KEY_LEN=32 # bytes